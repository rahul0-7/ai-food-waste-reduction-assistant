# Copy this file to ".env" and fill in your own key. Never commit the real .env file.

# Get a free key from https://aistudio.google.com/apikey (Google AI Studio — Gemini API)
GEMINI_API_KEY=your_api_key_here

# Optional: override the Gemini model. Defaults to gemini-3.6-flash if not set.
# GEMINI_MODEL=gemini-3.6-flash
